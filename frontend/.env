# 基础公共环境文件（vben 的 getConfFiles 固定要求 .env 存在,缺失会构建失败）
# 与 .env.production 合并:同名变量以 .env.production 为准

# 应用标题(index.html 的 ejs 渲染必需,缺失报 "VITE_GLOB_APP_TITLE is not defined")
VITE_GLOB_APP_TITLE = AT Web · 自动化测试平台

# Whether to open mock（改造：关闭 mock）
VITE_USE_MOCK = false

# public path
VITE_PUBLIC_PATH = /

# Whether to enable gzip or brotli compression
# Optional: gzip | brotli | none
# If you need multiple forms, you can use `,` to separate
VITE_BUILD_COMPRESS = 'none'

# Basic interface address SPA（改造：对齐 Flask 的 /api 前缀，生产同源）
VITE_GLOB_API_URL = /api

# File upload address， optional
# It can be forwarded by nginx or write the actual address directly
VITE_GLOB_UPLOAD_URL = /upload

# Interface prefix
VITE_GLOB_API_URL_PREFIX =
